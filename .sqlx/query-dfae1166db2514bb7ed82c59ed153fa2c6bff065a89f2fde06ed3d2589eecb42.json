  "query": "\n            WITH candidate AS (\n                SELECT id FROM series\n                WHERE processing_status = $1\n                LIMIT 1\n                FOR UPDATE SKIP LOCKED\n            )\n            UPDATE series\n            SET processing_status = $2\n            WHERE id = (SELECT id FROM candidate)\n            RETURNING\n                id\n            ",
